        "import statsmodels.api as sm\n",
        "\n",
        "def portfolio_stats(ls_returns, label, market_returns=None):\n",
        "    \"\"\"\n",
        "    Compute annualized mean, Sharpe ratio, and CAPM alpha with t-stat.\n",
        "    \"\"\"\n",
        "    r = ls_returns[\"ls_ret\"]\n",
        "    ann_mean   = r.mean() * 12\n",
        "    ann_sharpe = r.mean() / r.std() * np.sqrt(12)\n",
        "\n",
        "    if market_returns is not None:\n",
        "        aligned = pd.concat([r, market_returns], axis=1).dropna()\n",
        "        aligned.columns = [\"ls_ret\", \"mkt_ret\"]\n",
        "        X_capm = sm.add_constant(aligned[\"mkt_ret\"])\n",
        "        res = sm.OLS(aligned[\"ls_ret\"], X_capm).fit()\n",
        "        alpha   = res.params[\"const\"] * 12\n",
        "        alpha_t = res.tvalues[\"const\"]\n",
        "    else:\n",
        "        alpha, alpha_t = np.nan, np.nan\n",
        "\n",
        "    print(f\"\\n{label}\")\n",
        "    print(f\"  Annualized mean excess return: {ann_mean:.4f} ({ann_mean*100:.2f}%)\")\n",
        "    print(f\"  Annualized Sharpe ratio:       {ann_sharpe:.4f}\")\n",
        "    print(f\"  CAPM alpha (annualized):       {alpha:.4f} ({alpha*100:.2f}%)\")\n",
        "    print(f\"  CAPM alpha t-stat:             {alpha_t:.4f}\")\n",
        "\n",
        "    return {\"label\": label, \"ann_mean\": ann_mean, \"sharpe\": ann_sharpe,\n",
        "            \"alpha\": alpha, \"alpha_t\": alpha_t}\n",
        "\n",
        "# Value-weighted market return per period\n",
        "mkt_val  = meta_val.groupby(\"date\").apply(\n",
        "    lambda g: np.average(g[\"ret_excess\"], weights=g[\"mktcap_lag\"])\n",
        ").rename(\"mkt_ret\")\n",
        "\n",
        "mkt_test = meta_test.groupby(\"date\").apply(\n",
        "    lambda g: np.average(g[\"ret_excess\"], weights=g[\"mktcap_lag\"])\n",
        ").rename(\"mkt_ret\")\n",
        "\n",
        "# Performance for all four combinations\n",
        "results_3d = []\n",
        "results_3d.append(portfolio_stats(ls_val_en,  \"Elastic Net — Validation\", mkt_val))\n",
        "results_3d.append(portfolio_stats(ls_val_nn,  \"Neural Net  — Validation\", mkt_val))\n",
        "results_3d.append(portfolio_stats(ls_test_en, \"Elastic Net — Test\",       mkt_test))\n",
        "results_3d.append(portfolio_stats(ls_test_nn, \"Neural Net  — Test\",       mkt_test))\n",
        "\n",
        "print(f\"\\nMarket benchmark — Validation\")\n",
        "print(f\"  Annualized mean: {mkt_val.mean()*12*100:.2f}%\")\n",
        "print(f\"  Sharpe ratio:    {mkt_val.mean()/mkt_val.std()*np.sqrt(12):.4f}\")\n",
        "\n",
        "print(f\"\\nMarket benchmark — Test\")\n",
        "print(f\"  Annualized mean: {mkt_test.mean()*12*100:.2f}%\")\n",
        "print(f\"  Sharpe ratio:    {mkt_test.mean()/mkt_test.std()*np.sqrt(12):.4f}\")"
      ],
