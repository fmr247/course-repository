        "def assign_deciles(df, pred_col, decile_col):\n",
        "    \"\"\"\n",
        "    Assign stocks to decile portfolios each month based on predicted returns.\n",
        "    Uses ranked predictions to avoid qcut dropping bins when many values are tied.\n",
        "    \"\"\"\n",
        "    df = df.copy()\n",
        "\n",
        "    def month_deciles(x):\n",
        "        # If too few observations in a month, return NaN\n",
        "        if x.notna().sum() < 10:\n",
        "            return pd.Series(np.nan, index=x.index)\n",
        "\n",
        "        # Rank first so tied values do not break qcut\n",
        "        ranked = x.rank(method=\"first\")\n",
        "\n",
        "        return pd.qcut(ranked, 10, labels=False)\n",
        "\n",
        "    df[decile_col] = df.groupby(\"date\")[pred_col].transform(month_deciles)\n",
        "    df[decile_col] = pd.to_numeric(df[decile_col], errors=\"coerce\")\n",
        "\n",
        "    return df\n",
        "\n",
        "meta_val = assign_deciles(meta_val, \"pred_en\", \"decile_en\")\n",
        "meta_val = assign_deciles(meta_val, \"pred_nn\", \"decile_nn\")\n",
        "\n",
        "meta_test = assign_deciles(meta_test, \"pred_en\", \"decile_en\")\n",
        "meta_test = assign_deciles(meta_test, \"pred_nn\", \"decile_nn\")\n",
        "\n",
        "print(\"Decile assignment done.\")\n",
        "print(f\"NaN in decile_en (val): {meta_val['decile_en'].isna().sum()}\")\n",
        "print(\"Validation decile counts for Elastic Net:\")\n",
        "print(meta_val[\"decile_en\"].value_counts(dropna=False).sort_index())\n",
        "\n",
        "print(\"\\nTest decile counts for Elastic Net:\")\n",
        "print(meta_test[\"decile_en\"].value_counts(dropna=False).sort_index())"
      ],
