    "import statsmodels.api as sm\n",
    "\n",
    "def portfolio_stats(ls_returns, label, market_returns=None):\n",
    "    \"\"\"\n",
    "    Compute annualized mean, Sharpe ratio, and CAPM alpha with t-stat.\n",
    "    \"\"\"\n",
    "    r = ls_returns[\"ls_ret\"]\n",
    "    ann_mean   = r.mean() * 12\n",
    "    ann_sharpe = r.mean() / r.std() * np.sqrt(12)\n",
    "\n",
    "    if market_returns is not None:\n",
    "        aligned = pd.concat([r, market_returns], axis=1).dropna()\n",
    "        aligned.columns = [\"ls_ret\", \"mkt_ret\"]\n",
    "        X_capm = sm.add_constant(aligned[\"mkt_ret\"])\n",
    "        res = sm.OLS(aligned[\"ls_ret\"], X_capm).fit()\n",
    "        alpha   = res.params[\"const\"] * 12\n",
    "        alpha_t = res.tvalues[\"const\"]\n",
    "    else:\n",
    "        alpha, alpha_t = np.nan, np.nan\n",
    "\n",
    "    print(f\"\\n{label}\")\n",
    "    print(f\"  Annualized mean excess return: {ann_mean:.4f} ({ann_mean*100:.2f}%)\")\n",
    "    print(f\"  Annualized Sharpe ratio:       {ann_sharpe:.4f}\")\n",
    "    print(f\"  CAPM alpha (annualized):       {alpha:.4f} ({alpha*100:.2f}%)\")\n",
    "    print(f\"  CAPM alpha t-stat:             {alpha_t:.4f}\")\n",
    "\n",
    "    return {\"label\": label, \"ann_mean\": ann_mean, \"sharpe\": ann_sharpe,\n",
    "            \"alpha\": alpha, \"alpha_t\": alpha_t}\n",
